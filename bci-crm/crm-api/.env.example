# Local default uses SQLite (no Postgres required).
DATABASE_URL=sqlite:///./bci_crm_dev.db
CRM_API_HOST=127.0.0.1
CRM_API_PORT=8100
INTERNAL_API_TOKEN=dev-internal-token
AUTO_INIT_SCHEMA=true

# Production (Win VDI CRM Postgres on 5433):
# DATABASE_URL=postgresql+psycopg2://crm_app:YOUR_PASSWORD@127.0.0.1:5433/beltcollins_crm
# AUTO_INIT_SCHEMA=false
